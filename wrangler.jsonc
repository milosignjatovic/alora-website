// Alora website — static assets on Cloudflare Workers, no Worker script.
// Same shape as the doctor-report viewer in alora-mobile-app
// (web/report-viewer/wrangler.jsonc).
//
//   npm run dev      local preview on http://localhost:8787
//   npm run deploy   publishes to https://www.alora.workers.dev
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "www",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  // No per-version preview URLs: each would be one more public copy.
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
